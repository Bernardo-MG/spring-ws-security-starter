<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

   <modelVersion>4.0.0</modelVersion>

   <!-- ********************************************** -->
   <!-- ****************** BASE POM ****************** -->
   <!-- ********************************************** -->

   <parent>
      <groupId>com.bernardomg.framework</groupId>
      <artifactId>security</artifactId>
      <version>1.0.0-SNAPSHOT</version>
   </parent>

   <!-- ********************************************** -->
   <!-- **************** PROJECT INFO **************** -->
   <!-- ********************************************** -->

   <groupId>com.bernardomg.framework.security</groupId>
   <artifactId>rest-adapter</artifactId>
   <packaging>jar</packaging>

   <name>Security REST adapter</name>

   <!-- ********************************************** -->
   <!-- *************** DEPENDENCIES ***************** -->
   <!-- ********************************************** -->

   <dependencies>
      <!-- ============================================== -->
      <!-- ================= PROJECT ==================== -->
      <!-- ============================================== -->
      <dependency>
         <groupId>com.bernardomg.framework.security</groupId>
         <artifactId>access</artifactId>
      </dependency>
      <dependency>
         <groupId>com.bernardomg.framework.security</groupId>
         <artifactId>domain</artifactId>
      </dependency>
      <dependency>
         <groupId>com.bernardomg.framework.security</groupId>
         <artifactId>login-usecase</artifactId>
      </dependency>
      <dependency>
         <groupId>com.bernardomg.framework.security</groupId>
         <artifactId>account</artifactId>
      </dependency>
      <dependency>
         <groupId>com.bernardomg.framework.security</groupId>
         <artifactId>password</artifactId>
      </dependency>
      <!-- ============================================== -->
      <!-- ================== OPENAPI =================== -->
      <!-- ============================================== -->
      <dependency>
        <groupId>org.openapitools</groupId>
        <artifactId>jackson-databind-nullable</artifactId>
      </dependency>
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations</artifactId>
      </dependency>
      <!-- ============================================== -->
      <!-- ================== SPRING ==================== -->
      <!-- ============================================== -->
      <dependency>
         <!-- Spring Web MVC -->
         <groupId>org.springframework</groupId>
         <artifactId>spring-webmvc</artifactId>
      </dependency>
      <!-- ============================================== -->
      <!-- ================= JAKARTA ==================== -->
      <!-- ============================================== -->
      <dependency>
          <!-- Jakarta Servlet API -->
         <groupId>jakarta.servlet</groupId>
         <artifactId>jakarta.servlet-api</artifactId>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <!-- Jakarta validation -->
         <groupId>jakarta.validation</groupId>
         <artifactId>jakarta.validation-api</artifactId>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <!-- Jakarta validation -->
         <groupId>jakarta.annotation</groupId>
         <artifactId>jakarta.annotation-api</artifactId>
         <scope>provided</scope>
      </dependency>
   </dependencies>

   <!-- ********************************************** -->
   <!-- ******************* BUILD ******************** -->
   <!-- ********************************************** -->

   <build>
      <plugins>
          <plugin>
             <groupId>org.openapitools</groupId>
             <artifactId>openapi-generator-maven-plugin</artifactId>
             <executions>
                <execution>
                   <id>login</id>
                   <goals>
                      <goal>generate</goal>
                   </goals>
                   <configuration>
                      <inputSpec>${project.basedir}/src/main/resources/openapi/login.yml</inputSpec>
                      <apiPackage>com.bernardomg.security.adapter.outbound.rest.login.controller</apiPackage>
                      <modelPackage>com.bernardomg.security.adapter.outbound.rest.login.dto</modelPackage>
                   </configuration>
                </execution>
                <execution>
                   <id>login-register</id>
                   <goals>
                      <goal>generate</goal>
                   </goals>
                   <configuration>
                      <inputSpec>${project.basedir}/src/main/resources/openapi/login-register.yml</inputSpec>
                      <apiPackage>com.bernardomg.security.adapter.outbound.rest.login.controller</apiPackage>
                      <modelPackage>com.bernardomg.security.adapter.outbound.rest.login.dto</modelPackage>
                   </configuration>
                </execution>
                <execution>
                   <id>account</id>
                   <goals>
                      <goal>generate</goal>
                   </goals>
                   <configuration>
                      <inputSpec>${project.basedir}/src/main/resources/openapi/account.yml</inputSpec>
                      <apiPackage>com.bernardomg.security.adapter.outbound.rest.account.controller</apiPackage>
                      <modelPackage>com.bernardomg.security.adapter.outbound.rest.account.dto</modelPackage>
                   </configuration>
                </execution>
                <execution>
                   <id>user</id>
                   <goals>
                      <goal>generate</goal>
                   </goals>
                   <configuration>
                      <inputSpec>${project.basedir}/src/main/resources/openapi/user.yml</inputSpec>
                      <apiPackage>com.bernardomg.security.adapter.outbound.rest.user.controller</apiPackage>
                      <modelPackage>com.bernardomg.security.adapter.outbound.rest.user.dto</modelPackage>
                   </configuration>
                </execution>
                <execution>
                   <id>password</id>
                   <goals>
                      <goal>generate</goal>
                   </goals>
                   <configuration>
                      <inputSpec>${project.basedir}/src/main/resources/openapi/password.yml</inputSpec>
                      <apiPackage>com.bernardomg.security.adapter.outbound.rest.password.controller</apiPackage>
                      <modelPackage>com.bernardomg.security.adapter.outbound.rest.password.dto</modelPackage>
                   </configuration>
                </execution>
             </executions>
          </plugin>
      </plugins>
   </build>

</project>
